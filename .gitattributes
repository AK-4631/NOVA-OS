# NOVA OS repository line-ending and diff policy
# Text sources are normalized to LF so that scripts and patches apply
# identically on Windows hosts and on the Linux build host (WSL2 / target).
* text=auto

*.c   text
*.h   text
*.cpp text
*.hpp text
*.py  text
*.md  text
*.txt text
*.xml text
*.qml text
*.in  text
*.mk  text diff=make
*.yml text
*.yaml text
*.json text

# Build-system and platform files must stay byte-stable for patches and
# host scripts; force LF regardless of client settings.
Makefile      text eol=lf
*.cmake       text eol=lf
CMakeLists.txt text eol=lf
*.sh          text eol=lf
*.dts         text eol=lf
*.dtsi        text eol=lf
*.fragment    text eol=lf
*.config      text eol=lf
*.conf        text eol=lf
*.defconfig   text eol=lf
*.service     text eol=lf
*.rules       text eol=lf
*.ps1         text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# Binary artifacts that may be checked in (build inputs, captures)
*.png binary
*.jpg binary
*.7z  binary
*.zip binary
*.tar.gz binary
